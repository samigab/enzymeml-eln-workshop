                        Date, of Sample preparation
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="time_used" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Time when the sample has been used
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="Temperature" type="xs:float">
