                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="inert" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        x
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="light" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Wether the sample was under light
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Vessel Definition -->
    <xs:complexType name="VesselType">
        <xs:sequence>
            <xs:element name="id" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unique identifier of the vessel.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="name" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
